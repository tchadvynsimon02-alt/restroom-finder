{
  "expo": {
    "name": "Restroom Finder",
    "slug": "restroom-finder",
    "scheme": "restroomfinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F7F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.restroomfinder.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to find nearby restrooms."
      }
    },
    "android": {
      "package": "com.restroomfinder.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F7F5"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    }
  }
}
